{
  "name": "scripter",
  "version": "0.0.1",
  "private": true,
  "description": "AI presentation scripter — tracks speaker position in script via STT + embeddings",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "proto": "tsx src/prototype/run.ts",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "gen:samples": "tsx scripts/gen-sample-slides.ts",
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.main.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\""
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "nodejs-whisper": "^0.2.9",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shelljs": "^0.8.5",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/shelljs": "^0.8.15",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "pdfkit": "^0.18.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
